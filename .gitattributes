# Normalize line endings for text files
* text=auto eol=lf

*.md text eol=lf
*.txt text eol=lf

# Binary files - do not diff, do not normalize
*.pdf binary
*.zip binary
*.mp4 binary
*.png binary
*.jpg binary
*.jpeg binary
*.docx binary
*.pptx binary
*.xlsx binary

# Exclude bulky/raw materials from GitHub language stats and diffs
resources/org/** -diff linguist-generated
resources/md/**/*.png -diff linguist-generated
